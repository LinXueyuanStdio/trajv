# VS Code Marketplace Personal Access Token
# 获取方式: https://dev.azure.com → User Settings → Personal Access Tokens → New Token
# Scopes: Marketplace > Manage
VSCE_PAT=your_vsce_pat_here

# Open VSX Registry Personal Access Token
# 获取方式: https://open-vsx.org/user-settings/tokens
OVSX_PAT=your_ovsx_pat_here