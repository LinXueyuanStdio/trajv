{
  "name": "trajv-jsonl-viewer",
  "displayName": "TrajV JSONL Viewer",
  "description": "轨迹浏览器，打开并展示 agent rollout 文件，本质是 .jsonl 文件。https://linxueyuan.online/trajv",
  "version": "0.2.2",
  "publisher": "LinXueyuanStdio",
  "license": "MIT",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "jsonl",
    "agent trajectory",
    "agent rollout",
    "rollout",
    "trajectory",
    "viewer",
    "custom editor",
    "webview"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1f22",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LinXueyuanStdio/trajv"
  },
  "bugs": {
    "url": "https://github.com/LinXueyuanStdio/trajv/issues"
  },
  "homepage": "https://github.com/LinXueyuanStdio/trajv#readme",
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "trajv.jsonlViewer",
        "displayName": "JSONL Viewer (TrajV)",
        "selector": [
          {
            "filenamePattern": "**/*.rollout.jsonl"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:icon && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepackage": "mkdir -p dist",
    "package": "npm run prepackage && vsce package --out dist/trajv-jsonl-viewer-${npm_package_version}.vsix",
    "publish:marketplace": "vsce publish",
    "build:icon": "node scripts/build-icon.js",
    "lint": "echo 'No linter configured'"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.6.3",
    "vsce": "^1.97.0"
  },
  "dependencies": {
    "vanilla-jsoneditor": "^3.11.0"
  }
}
